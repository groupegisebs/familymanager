[Unit]
Description=FamiRepère
After=network.target

[Service]
User=ubuntu
WorkingDirectory=__APP_ROOT__/app
ExecStart=/usr/bin/dotnet __APP_ROOT__/app/FamiRepere.Server.dll
Restart=always
RestartSec=5
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://0.0.0.0:__LISTEN_PORT__
Environment=DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
Environment=ConnectionStrings__Sqlite=Filename=__APP_ROOT__/data/famirepere.db
Environment=SeedAdmin__Email=__SEED_EMAIL__
Environment=SeedAdmin__Password=__SEED_PASSWORD__
Environment=Mail__Host=__MAIL_HOST__
Environment=Mail__Port=__MAIL_PORT__
Environment=Mail__User=__MAIL_USER__
Environment=Mail__Password=__MAIL_PASSWORD__
Environment=Mail__From=__MAIL_FROM__
StandardOutput=append:__APP_ROOT__/data/service.log
StandardError=append:__APP_ROOT__/data/service.log

[Install]
WantedBy=multi-user.target
